{
  "name": "@jeangrey/sbc",
  "version": "0.2.0",
  "description": "A vue-cli style interactive CLI to scaffold, search and run Spring Boot projects (monorepo-aware), powered by Spring Initializr.",
  "type": "module",
  "bin": {
    "sbc": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "spring-boot",
    "cli",
    "scaffold",
    "initializr",
    "generator",
    "monorepo",
    "spring-initializr"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
